# Dependencies
node_modules/
jspm_packages/
web_modules/

# Environment variables and secrets (NEVER commit these)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Keep the example template tracked if you use one
!.env.example

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Build and Compilation outputs (if using TypeScript/Babel)
dist/
build/
out/
.next/
.nuxt/
*.tsbuildinfo

# Optional npm cache directory
.npm
.eslintcache
.stylelintcache
.cache

# IDEs and editors
